{
  "schemaVersion": 1,
  "id": "rsinsertexportupgrade",
  "version": "${version}",
  "name": "Refined Wireless Upgrades",
  "description": "Adds various upgrade cards which can be installed into any Wireless Grid.",
  "authors": [
    "Ultramega"
  ],
  "contact": {
    "sources": "https://github.com/starforcraft/Refined-Wireless-Upgrades",
    "issues": "https://github.com/starforcraft/Refined-Wireless-Upgrades/issues"
  },
  "icon": "logo.png",
  "license": "MIT",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.ultramega.refinedwirelessupgrades.fabric.ModInitializerImpl"
    ],
    "client": [
      "com.ultramega.refinedwirelessupgrades.fabric.ClientModInitializerImpl"
    ],
    "refinedstorage_plugin": [
      "com.ultramega.refinedwirelessupgrades.fabric.ModInitializerImpl"
    ],
    "jei_mod_plugin": [
      "com.ultramega.refinedwirelessupgrades.common.compat.jei.JeiModPlugin"
    ]
  },
  "custom": {
    "modmenu": {
      "links": {
        "modmenu.discord": "https://discord.gg/WpUmcmUayN"
      },
      "parent": "refinedstorage"
    }
  },
  "mixins": [
    "rsinsertexportupgrade.mixins.json"
  ],
  "accessWidener": "rsinsertexportupgrade.accesswidener",
  "depends": {
    "fabricloader": ">=0.19.1",
    "fabric-api": "*",
    "minecraft": "~26.1.2",
    "refinedstorage": ">=3.2.1",
    "java": ">=25",
    "cloth-config2": "*",
    "team_reborn_energy": "*"
  },
  "suggests": {
    "modmenu": "*"
  }
}